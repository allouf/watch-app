<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".minigameT1.MinigameT1S5Fragment"
    android:padding="0dp"
    android:background="@color/black">
    <!--app:boxedEdges="all"-->
    <androidx.constraintlayout.widget.ConstraintLayout

        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- rules explanation TextView -->
        <TextView
            android:id="@+id/txtViewRulesExplan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center_horizontal"
            android:text=" Wait for interaction. It will come soon."
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_marginTop="50dp"
            app:layout_constraintTop_toBottomOf="@id/txtViewStart"
            app:layout_constraintBottom_toTopOf="@id/txtViewTimerS5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <!-- start TextView -->
        <TextView
            android:id="@+id/txtViewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/visitor2"
            android:gravity="center_horizontal"
            android:text= "START"
            android:layout_marginLeft="5dp"
            android:textColor="#FFFFFF"
            android:textSize="60dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/txtViewRulesExplan"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <!-- timer TextView -->
        <TextView
            android:id="@+id/txtViewTimerS5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center_horizontal"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="50dp"
            android:textSize="20sp"
            android:text="*H *Min *Sec"
            app:layout_constraintTop_toBottomOf="@id/txtViewRulesExplan"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.wear.widget.BoxInsetLayout>