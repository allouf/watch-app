<?xml version="1.0" encoding="utf-8"?>
<com.incentives.prototype.CustomScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/scrollViewEditor"
    tools:context=".minigameT1.EditorFragment">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:id="@+id/frameLayout_content">

        <ImageButton
            android:id="@+id/hintButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|center"
            android:background="@drawable/arrow_up"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:contentDescription="@string/hint_description"
            app:layout_constraintTop_toTopOf="parent"></ImageButton>

        <TextView
            android:id="@+id/editor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginTop="1dp"
            android:scrollbarStyle="outsideInset"
            android:scrollbars="vertical"
            android:minHeight="60dp"
            android:text=""
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hintButton" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/slideAnimationView"
            android:layout_width="110dp"
            android:layout_height="75dp"
            android:elevation="8dp"
            android:visibility="gone"
            android:layout_marginTop="70dp"
            app:lottie_fileName="slide-left.json"
            app:layout_constraintBottom_toTopOf="@id/next"
            app:layout_constraintEnd_toEndOf="@id/editor"
            app:layout_constraintStart_toStartOf="@id/editor"
            app:layout_constraintTop_toTopOf="@id/editor" />

        <TextView
            android:id="@+id/next"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="bottom|center_horizontal"
            android:text="Next"
            android:textColor="@color/blue_a400"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/editor" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.incentives.prototype.CustomScrollView>