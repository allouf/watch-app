<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".minigameT1.MinigameT1F1"
    android:padding="0dp">
    <!--app:boxedEdges="all">-->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="0dp"
        >
        <pl.droidsonroids.gif.GifImageView
            android:src="@drawable/disappointed"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:layout_width="wrap_content"></pl.droidsonroids.gif.GifImageView>


            <Button
                android:id="@+id/btnNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next"
                android:textSize="16dp"
                android:layout_gravity="bottom|center_horizontal"></Button>

            <TextView
                android:id="@+id/txtViewGoodJob"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:padding="@dimen/screen_percentage_10"
                android:text="     Disappointed! "
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:translationY="19dp"
                tools:layout_editor_absoluteY="19dp" />
    </FrameLayout>
</androidx.wear.widget.BoxInsetLayout>