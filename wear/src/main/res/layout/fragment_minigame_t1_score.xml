<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".minigameT1.MinigameT1Score"
    android:padding="5dp"
    android:background="@color/white">
    <!--app:boxedEdges="all"-->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="8dp"
        >
        <!--        android:padding="5dp"-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            >

            <!--<ImageView
                android:id="@+id/imgViewBackground"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cup"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />-->

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/confettiAnim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:lottie_fileName="confetti.json"
                app:lottie_repeatCount="1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/careerSuccessAnim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:lottie_fileName="career-success.json"
                app:lottie_loop="false"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <TextView
                android:id="@+id/txtViewDesc1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Your total score"
                android:textColor="@color/black"
                android:gravity="center"
                android:textSize="18dp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/txtViewScore"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="5dp"
                android:text="-"
                android:gravity="center"
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="@color/red_a200"
                app:layout_constraintTop_toBottomOf="@id/txtViewDesc1" />
            <TextView
                android:id="@+id/txtViewDesc2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:text="Amazing Work!"
                android:textColor="@color/black"
                android:gravity="center"
                android:textSize="18dp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/txtViewScore" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageButton
            android:id="@+id/btnToT1S1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center"
            android:layout_marginBottom="0dp"
            android:background="@drawable/arrow"></ImageButton>

    </FrameLayout>
</androidx.wear.widget.BoxInsetLayout>